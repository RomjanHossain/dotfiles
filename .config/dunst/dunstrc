# [global]
# # Settings
# notification_limit = 5
#
[global]
    monitor = 0
    follow = keyboard
    width = 370
    height = (0,350)
    offset = (0,19)
    padding = 2
    horizontal_padding = 2
    transparency = 25
    font = Cartograph CF 12
    format = "<b>%s</b>\n%b"
