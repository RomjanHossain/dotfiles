#!/bin/bash

# Mounts Android Phones and USB drives (encrypted or not)
# TODO: Try decrypt for drives in crypttab
# TODO: Add support for iPhones

IFS=$'\n'

escape() {
    echo "$@" | iconv -cf UTF-8 -t ASCII//TRANSLIT | tr -d '[:punct:]' | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed "s/-\+/-/g;s/\(^-\|-\$\)//g"
}

# Check for phones
phones="$(simple-mtpfs -l 2>/dev/null | sed "s/^/📱/")"
mountedphones="$(grep "simple-mtpfs" /etc/mtab)"

if [ -n "$mountedphones" ]; then
    phones="$(for phone in $phones; do
        escphone="$(escape "$phone")"
        skip=0
        for mounted in $mountedphones; do
            if [[ "$mounted" =~ $escphone ]]; then
                skip=1
                break
            fi
        done
        [ "$skip" -eq 1 ] && continue
        echo "$phone"
    done)"
fi

# Drives
lsblkoutput="$(lsblk -rpo "uuid,name,type,size,label,mountpoint,fstype")"
allluks="$(echo "$lsblkoutput" | grep crypto_LUKS)"
decrypted="$(find /dev/disk/by-id/ -name 'dm-uuid-CRYPT-LUKS2-*' 2>/dev/null | sed "s|.*LUKS2-||;s|-.*||")"

filter() {
    sed "s/ /:/g" | awk -F':' '$7==""{printf "%s%s (%s) %s\n",$1,$3,$5,$6}'
}

unopenedluks="$(for drive in $allluks; do
    uuid="${drive%% *}"
    uuid_nodash="${uuid//-/}"
    is_open=0
    for open in $decrypted; do
        [ "$uuid_nodash" = "$open" ] && is_open=1 && break
    done
    [ "$is_open" -eq 1 ] && continue
    echo "🔒 $drive"
done | filter)"

normalparts="$(echo "$lsblkoutput" | grep -v crypto_LUKS | grep -E 'part|rom|crypt' | sed "s/^/💾 /" | filter)"

alldrives="$(echo "$phones
$unopenedluks
$normalparts" | sed "/^$/d;s/ *$//")"

set -e

test -n "$alldrives"

chosen="$(echo "$alldrives" | dmenu -p "Mount which drive?" -i)"

getmount() {
    mp="$(find /mnt /media /mount /home -maxdepth 1 -type d 2>/dev/null | dmenu -i -p "Mount this drive where?")"
    test -n "$mp"
    if [ ! -d "$mp" ]; then
        mkdiryn=$(printf "No\nYes" | dmenu -i -p "$mp does not exist. Create it?")
        [ "$mkdiryn" = "Yes" ] && (mkdir -p "$mp" || sudo -A mkdir -p "$mp")
    fi
}

attemptmount() {
    sudo -A mount "$chosen" && notify-send "💾 Drive Mounted." "$chosen mounted." && exit 0
    return 1
}

case "$chosen" in
💾*)
    chosen="${chosen%% *}"
    chosen="${chosen:1}" # remove symbol
    attemptmount || getmount
    sudo -A mount "$chosen" "$mp" -o uid="$(id -u)",gid="$(id -g)"
    notify-send "💾 Drive Mounted." "$chosen mounted to $mp."
    ;;

🔒*)
    chosen="${chosen%% *}"
    chosen="${chosen:1}"
    num=0
    while [ -e "/dev/mapper/usb$num" ]; do
        num=$((num + 1))
    done
    name="usb$num"
    term="${TERMINAL:-st}"
    "$term" -n floatterm -g 60x1 -e sudo cryptsetup open "$chosen" "$name"
    test -b "/dev/mapper/$name"
    attemptmount || getmount
    sudo -A mount "/dev/mapper/$name" "$mp" -o uid="$(id -u)",gid="$(id -g)"
    notify-send "🔓 Decrypted Drive Mounted." "$chosen decrypted and mounted to $mp."
    ;;

📱*)
    notify-send "❗ Note" "Remember to allow file access on your phone now."
    getmount
    number="${chosen%%:*}"
    number="${number:1}"
    sudo -A simple-mtpfs -o allow_other -o fsname="simple-mtpfs-$(escape "$chosen")" --device "$number" "$mp"
    notify-send "🤖 Android Mounted." "Android device mounted to $mp."
    ;;
esac
